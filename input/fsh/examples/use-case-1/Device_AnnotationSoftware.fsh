Instance: AnnotationSoftwareUC1
InstanceOf: Device
Title: "Annotation Software on Device (UC1)"
Description: "Software on the device that labels the IMU data in real time during the recording. The version identifies the software and classification model that produced the labels, see the Provenance of the annotation run."
Usage: #example
* id            = "uc1-001-label-annotation-software-on-device"
* type          = $sct#706689003 "Application programme software"
* name.value    = "HAR annotation app"
* name.type     = #user-friendly-name
* version.value = "2.1.0" // software and model version used in this session
