Instance: UseCase2Bundle
InstanceOf: Bundle
Title: "All Resources of Use Case 2 (UC2)"
Description: "Collection Bundle with all example resources of use case 2, so that the whole example can be loaded and validated at once. References between the resources resolve within the Bundle through fullUrl."
Usage: #example
* id                = "uc2-bundle"
* type              = #collection
* timestamp         = "2024-07-01T16:00:00+02:00"
