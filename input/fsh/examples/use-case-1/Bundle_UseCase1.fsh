Instance: UseCase1Bundle
InstanceOf: Bundle
Title: "All Resources of Use Case 1 (UC1)"
Description: "Collection Bundle with all example resources of use case 1, so that the whole example can be loaded and validated at once. References between the resources resolve within the Bundle through fullUrl."
Usage: #example
* id                = "uc1-bundle"
* type              = #collection
* timestamp         = "2024-07-01T09:40:00+02:00"
* entry[0].fullUrl  = "https://fudickar-lab.github.io/WHIR/Patient/uc1-001-patient"
* entry[=].resource = PHDPatientTestUC1
